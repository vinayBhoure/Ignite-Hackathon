# --- Tavily (search API for AI agents) ---
# Get a free key at https://app.tavily.com
TAVILY_API_KEY=

# --- Neo4j (graph database) ---
# Easiest: spin up a free instance at https://console.neo4j.io (Aura Free)
# It gives you a connection URI like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Cognee (AI memory / knowledge graph layer for agents) ---
# Cognee needs TWO models: an LLM (for extracting entities/relationships)
# and a separate embedding model (for search). Leaving either unset makes
# it silently fall back to OpenAI, which then errors without an OpenAI key.
#
# Using Gemini for both - one free key at https://aistudio.google.com/apikey
# covers it, and the free tier (~1500 req/day, 1M tokens/min) is generous
# enough for a hackathon day. Double-check the exact model string against
# https://docs.cognee.ai/setup-configuration/llm-providers if this errors -
# provider model names shift.
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=

EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/text-embedding-004
EMBEDDING_API_KEY=

# Alternative: Groq for the LLM (faster, but no embeddings of its own) +
# Fastembed for embeddings (runs locally, no key needed at all). Swap in:
#   LLM_PROVIDER=groq
#   LLM_MODEL=groq/llama-3.3-70b-versatile
#   LLM_API_KEY=<your groq key>
#   EMBEDDING_PROVIDER=fastembed
#   EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
#   (no EMBEDDING_API_KEY needed for fastembed)

# --- Render ---
# No local key needed for the hackathon itself - Render deploys from your
# git repo via their dashboard (render.com). render.yaml below is a starter
# blueprint for when you're ready to deploy.

# --- Track B: API + UI (Exposure-Aware Fleet Routing, Delhi NCR) ---

# Google Maps: server key for Geocoding/Routes API calls from core/ (no HTTP referrer restriction).
GOOGLE_MAPS_SERVER_KEY=
# Google Maps: browser key for the Maps JS route/zone display, restricted to your demo domain(s).
GOOGLE_MAPS_BROWSER_KEY=

# Gemini: place-query normalization and one-sentence grounded explanations (core/places, core/kg).
# Separate from LLM_API_KEY above, which is Cognee's key - keep them independent even if same provider.
GEMINI_API_KEY=

# Web Push (VAPID). Generate with: python -c "from pywebpush import webpush" or the vapid CLI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Demo area bounds for Delhi NCR (lat_min,lng_min,lat_max,lng_max) - clamps geocoding and the zone map.
DEMO_AREA_BOUNDS=
# H3 resolution for zone indexing (PRD default: 8).
H3_RES=8
# Sensor search radius (km) for inverse-distance-squared zone PM2.5 weighting (PRD default: 3).
SENSOR_RADIUS_KM=3

# Track B mock flag: true = hardcoded routes/scores, false = real core/ calls (flip at the sync point).
USE_MOCKS=true

# --- Auth + front-door URLs ---
# Signs the session cookie/token shared by the API and the Streamlit console.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Where the login page sends a dispatcher after sign-in (the Streamlit service).
CONSOLE_URL=http://127.0.0.1:8501
# Where the console links back to for sign-in/sign-out and the rider app (the FastAPI service).
PUBLIC_API_URL=http://127.0.0.1:8010
